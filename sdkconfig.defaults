# HMC5883L logger. This PlatformIO release reads this file name.
# Wi-Fi SoftAP on. Bluetooth off. Flash size matches DevKitC-1-N8 (8 MB, no PSRAM).
CONFIG_DSP_MAX_FFT_SIZE_2048=y

# CONFIG_BT_ENABLED is not set

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=y
CONFIG_ESP_PHY_MAX_WIFI_TX_POWER=10
CONFIG_ESP_PHY_MAX_TX_POWER=10
